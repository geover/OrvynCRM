# =====================================================================================================================
# OrvynCRM environment file. Copy to .env, then run `php artisan key:generate`.
#
# Which settings live HERE and which live IN THE APP:
#   - Here: the application itself, the databases, queues, cache, files, and the DEFAULT e-mail server.
#   - In the app, as a platform administrator (Platform > Settings): the e-mail server override, SendGrid event reports, the
#     platform's Twilio account for SMS, calls (caller IDs), pricing and the sign-in page. Those are stored (secrets encrypted)
#     in the central database, so they never need to be in this file.
#   - In the app, as a company administrator (Admin settings): the company's own Keap key, its look and its users.
# =====================================================================================================================

# --- Application -----------------------------------------------------------------------------------------------------
# Name shown in e-mails and the browser tab until the platform sets its own (Platform > Settings > Sign-in page).
APP_NAME=OrvynCRM
# local | production. In production also set APP_DEBUG=false.
APP_ENV=local
# Encryption key: created by `php artisan key:generate`. Never share it or change it later: every stored secret (e-mail
# password, Twilio token, Keap keys, API tokens) is encrypted with it and becomes unreadable if it changes.
APP_KEY=
# true shows error pages with details. Must be false in production.
APP_DEBUG=true
# The public address of the app, with https in production. It is used in e-mail links, tracking pixels and the callback
# addresses given to Twilio and SendGrid, so it must be reachable from the internet in production. When the public website
# lives apart from the app (www.example.com for the website, app.example.com for the CRM), this is the app address.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Number of PHP workers for `php artisan serve` (local development only).
# PHP_CLI_SERVER_WORKERS=4

# Password hashing cost: higher is slower and safer.
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug in development, warning or error in production.
LOG_LEVEL=debug
# Logs queries slower than a threshold (outside production). Set to false to switch it off.
# LOG_SLOW_QUERIES=true

# --- Central database ----------------------------------------------------------------------------------------------------
# DB_* is the CENTRAL accounts database: people, companies, platform settings, requests, messages, metrics.
# Every company also gets its own database, created automatically (see "Multi-tenancy" below).
# sqlite for a quick local look; mysql for real use (MySQL 8 or MariaDB 10.6+).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=orvyn_crm_accounts
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions, cache, queue, files ---------------------------------------------------------------------------------------
# database is fine to start with; use redis in production (also set REDIS_* below).
SESSION_DRIVER=database
# Minutes of inactivity before a sign-in expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local | s3. Use s3 in production for uploads (see AWS_* below).
FILESYSTEM_DISK=local
# Where background jobs wait: sync (run at once, tests only) | database | redis.
# Run workers with: php artisan queue:work --queue=ticks,automations,webhooks,messages,default
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (only when SESSION_DRIVER, CACHE_STORE or QUEUE_CONNECTION is redis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail: the DEFAULT server --------------------------------------------------------------------------------------------
# Every e-mail the app sends (messages to contacts, password resets, notifications to platform administrators) goes through
# this server UNLESS a platform administrator saves another one under Platform > Settings > E-mail server, which then
# replaces these values (the password is stored encrypted in the database).
#   log  = nothing is sent, e-mails are written to the log (development)
#   smtp = a real server. For SendGrid use: host smtp.sendgrid.net, port 587, username "apikey", password = a SendGrid API key.
MAIL_MAILER=log
# null for "start TLS when the server offers it"; smtps for SSL from the start (usually port 465).
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
# SMTP login. For SendGrid the username is the word apikey.
MAIL_USERNAME=null
# SMTP password. For SendGrid this is the API key (starts with SG.).
MAIL_PASSWORD=null
# The address e-mails are sent from. It must be a sender your provider has verified, or mail is refused or lands in spam.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Most e-mails sent per minute, across all workers (protects your sending reputation and the provider's limits).
MAIL_RATE_PER_MINUTE=600

# --- File storage (S3 or compatible) -------------------------------------------------------------------------------------------
# --- Platform integrations: defaults ---------------------------------------------------------------------------------------------
# What the platform uses for e-mail and text messages until a platform administrator saves other values under Platform >
# Settings (E-mail server, SMS). A value saved there REPLACES the one here; a field left empty there falls back to this file.
# The lines below are SAMPLES: remove the leading "# " and put in your own credentials. Never commit real ones.
#
# SendGrid (e-mail), over SMTP. Replaces the MAIL_* values above (which point at a local Mailpit while developing):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxx.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
#   MAIL_FROM_ADDRESS="no-reply@yourdomain.com"      (a sender or domain verified in SendGrid)
# SendGrid's Event Webhook (bounces, unsubscribes, clicks): the "verification key" of its signed webhook. Without it, events are
# accepted on the secret in the webhook address alone.
# SENDGRID_WEBHOOK_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx==
#
# Twilio (text messages): the platform's own account, used by every company that has not set up its own. Give a number OR a
# messaging service. With a complete account here the SMS feature is on by default.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (company subscriptions): normally entered under Platform > Settings > Payments. These are the fallback.
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Used when FILESYSTEM_DISK=s3: attachments, exports. Works with AWS S3, Backblaze B2, MinIO and similar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# true for MinIO and some other S3-compatible services.
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# --- Sign-in and API ------------------------------------------------------------------------------------------------------------
# The administrator of the demo company created by `php artisan migrate --seed`. Local use: change or remove it elsewhere.
ADMIN_EMAIL=admin@orvyncrm.test
ADMIN_PASSWORD=
# The domains from which the browser app may call the API with its session cookie (no scheme). Set it to your real
# domain(s) in production, for example app.example.com.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
# Most API requests per minute per person (a safety net against runaway scripts).
# API_RATE_PER_MINUTE=300

# --- Provider callbacks: single-database test mode ONLY -------------------------------------------------------------------------
# With companies, each company has its own secret in its callback address (shown under its Admin settings > App details), and
# SendGrid's event reports use the platform address under Platform > Settings > E-mail server. These two tokens are only used
# in single-database mode, which exists for automated tests. Leave them empty.
SENDGRID_WEBHOOK_TOKEN=

TWILIO_WEBHOOK_TOKEN=

# --- Old product import --------------------------------------------------------------------------------------------------------------
# Connection to the OLD CRM's database. Only needed for `php artisan orvyn:import-macanta`; leave empty otherwise.
# Use a read-only user and run the import against a COPY first.
MACANTA_DB_HOST=127.0.0.1
MACANTA_DB_PORT=3306
MACANTA_DB_DATABASE=
MACANTA_DB_USERNAME=
MACANTA_DB_PASSWORD=

# --- Multi-tenancy (one database per company) ---------------------------------------------------------------------------------------
# DB_* above is the central accounts database. Each company gets its own database named <TENANCY_DB_PREFIX><company id>,
# created automatically, so on MySQL the database user needs CREATE and DROP on that prefix, for example:
#   GRANT ALL ON `orvyn\_crm\_%`.* TO 'orvyn'@'%';
# Example MySQL setup:
#   DB_CONNECTION=mysql   DB_HOST=127.0.0.1   DB_PORT=3306   DB_DATABASE=orvyn_crm_accounts   DB_USERNAME=orvyn   DB_PASSWORD=...
# TENANCY_DB_PREFIX=orvyn_crm_t_
# Optional text added after the company id in the database name.
# TENANCY_DB_SUFFIX=
# For SQLite, the folder the company databases live in.
# TENANCY_SQLITE_PATH=
# Single-database mode keeps company and central tables together. For automated tests only: leave false.
TENANCY_SINGLE_DATABASE=false

# The first platform administrator, created by `php artisan migrate --seed` (the person who manages every company).
# PLATFORM_EMAIL=platform@example.com
# PLATFORM_PASSWORD=
# The demo company created by `php artisan migrate --seed`.
DEMO_COMPANY="Demo Company"
DEMO_COMPANY_SLUG=demo

# What a NEW company may have; the platform can change it per company afterwards (Platform > Companies > Edit).
# Active users per company.
DEFAULT_MAX_USERS=5
# Data objects (record types) per company.
DEFAULT_MAX_DATA_OBJECTS=10
# Automations per data object. A company can ask for more; approving the request raises it for that data object only.
DEFAULT_MAX_AUTOMATIONS_PER_OBJECT=5

# --- Queues: long jobs ---------------------------------------------------------------------------------------------------------------
# Jobs that can run for a long time (imports, syncs, big sends) use their own connection with a longer retry_after.
# QUEUE_LONG_CONNECTION=database-long
# Seconds before a stuck short job is retried; keep it above the longest short-job timeout (300 s).
DB_QUEUE_RETRY_AFTER=400
# Same for long jobs; keep it above their longest timeout (3600 s).
QUEUE_LONG_RETRY_AFTER=3900

# --- Search ----------------------------------------------------------------------------------------------------------------------------
# Shortest word MySQL FULLTEXT indexes (innodb_ft_min_token_size); shorter words use LIKE.
# Set it to the same number if you lowered that MySQL server setting.
FULLTEXT_MIN_WORD=3

# =====================================================================================================================
# NOT in this file, on purpose (set them in the app):
#   Twilio (SMS):   Platform > Settings > SMS. A company may also set up its own Twilio account (its own integration).
#   SendGrid:       Platform > Settings > E-mail server (the "Use SendGrid" button, then the Event Webhook address).
#   Calls:          Platform > Settings > Calls (default caller ID).
#   Keap:           each company, under Admin settings > Keap (the platform then switches the sync on).
#   reCAPTCHA v3:   Platform > Settings > Bot protection (site key and secret key from Google; the secret is stored encrypted).
# =====================================================================================================================

# Security (see docs/DEPLOYMENT.md): the proxies whose X-Forwarded-* headers are believed (empty = none, "*" = all, or addresses); the policy mode: enforce | report | off
# TRUSTED_PROXIES=
# SECURITY_CSP=enforce
# SECURITY_HSTS=true
