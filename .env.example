APP_NAME=OrvynCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- OrvynCRM ---
ADMIN_EMAIL=admin@orvyn.test
ADMIN_PASSWORD=
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
MAIL_RATE_PER_MINUTE=600
SENDGRID_WEBHOOK_TOKEN=
TWILIO_WEBHOOK_TOKEN=

# Legacy Macanta database (only needed for `php artisan orvyn:import-macanta`)
MACANTA_DB_HOST=127.0.0.1
MACANTA_DB_PORT=3306
MACANTA_DB_DATABASE=
MACANTA_DB_USERNAME=
MACANTA_DB_PASSWORD=

# --- Multi-tenancy (one database per company; the default connection is the central accounts database) ---
# MySQL: DB_* is the central accounts database; each company gets <TENANCY_DB_PREFIX><company id>, created automatically,
# so the DB user needs CREATE/DROP on that prefix (e.g. GRANT ALL ON `orvyn\_crm\_%`.* TO ...).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=orvyn_crm_accounts
# DB_USERNAME=orvyn
# DB_PASSWORD=
# TENANCY_DB_PREFIX=orvyn_crm_t_
# PLATFORM_EMAIL=platform@example.com
# PLATFORM_PASSWORD=
# What a NEW company may have; the platform can change it per company afterwards (Platform > Companies > Edit).
# Users, data objects, and automations per data object (raised for one data object when a request is approved).
DEFAULT_MAX_USERS=5
DEFAULT_MAX_DATA_OBJECTS=10
DEFAULT_MAX_AUTOMATIONS_PER_OBJECT=5
DEMO_COMPANY="Demo Company"
DEMO_COMPANY_SLUG=demo
# Company databases are named <prefix><company id><suffix>; for SQLite they live in this folder
# TENANCY_SQLITE_PATH=
# Single-database mode keeps company and central tables together. Only for automated tests.
TENANCY_SINGLE_DATABASE=false

# --- Queues ---
# Jobs that can run for a long time (imports, syncs, big sends) use their own connection with a longer retry_after.
# QUEUE_LONG_CONNECTION=database-long
DB_QUEUE_RETRY_AFTER=400
QUEUE_LONG_RETRY_AFTER=3900

# --- Search ---
# Shortest word MySQL FULLTEXT indexes (innodb_ft_min_token_size); shorter words use LIKE
FULLTEXT_MIN_WORD=3
# TENANCY_DB_SUFFIX=
