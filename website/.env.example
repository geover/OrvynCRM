# The marketing website for OrvynCRM. Copy to .env for local work. Every PUBLIC_ value ends up in the built pages: no secrets here.

# Where the CRM itself lives. Every "Sign in" and "Open the app" button points here.
PUBLIC_APP_URL=http://localhost:8000

# The demo form. Build it in OrvynCRM (Admin settings, Form builder), then paste the address in the form's embed code, the one
# ending in .js (for example https://app.example.com/f/<form id>.js). Answers then arrive as contacts in your own CRM.
# Left empty, the page shows an e-mail button addressed to PUBLIC_CONTACT_EMAIL instead.
PUBLIC_DEMO_FORM_URL=
PUBLIC_CONTACT_EMAIL=hello@example.com

# The business address printed on the Privacy Policy and Terms of Use (leave empty to leave it out). Use a backslash and n for a new line.
PUBLIC_BUSINESS_ADDRESS=

# The public address of this website (sitemap, canonical links, social previews).
SITE_URL=http://localhost:4321
