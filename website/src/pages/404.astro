---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
    <section class="container-page py-28 text-center">
        <p class="eyebrow">404</p>
        <h1 class="mt-2 text-4xl font-semibold">We could not find that page</h1>
        <p class="mt-4 text-stone-600">It may have moved, or the address may be mistyped.</p>
        <a href="/" class="btn-primary mt-8">Back to the home page</a>
    </section>
</Base>
