---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import Icon from '../components/Icon.astro';
import { comparison, reasons } from '../data/site';

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const short = ['Fits your business', 'Follow-ups that happen', 'E-mail and SMS built in', 'Your data stays apart', 'Clear limits', 'Plays well with others'];
---
<Base title="Why OrvynCRM" description="Why teams choose OrvynCRM: it fits your business, automates the follow-ups, keeps your data separate and shows you what happened.">
    <!-- A plain page header, not a hero: this page is for reading and comparing. -->
    <header class="border-b border-stone-200 bg-stone-100/60">
        <div class="container-page py-10 sm:py-14">
            <nav aria-label="Breadcrumb" class="text-xs text-stone-500"><a href="/" class="hover:text-brand-700">Home</a> <span aria-hidden="true">/</span> <span class="text-stone-700">Why OrvynCRM</span></nav>
            <h1 class="mt-4 max-w-3xl text-3xl font-semibold sm:text-4xl">Why teams choose OrvynCRM</h1>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">Six things OrvynCRM does that make the daily work lighter, and how it compares with the way many teams run their customer work today.</p>
        </div>
    </header>

    <div class="container-page grid gap-10 py-12 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-14 lg:py-16">
        <!-- the table of contents: stays in view while reading -->
        <aside class="hidden lg:block">
            <nav aria-label="On this page" class="sticky top-24">
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">On this page</p>
                <ol class="mt-4 space-y-1 border-l border-stone-200 text-sm">
                    {reasons.map((r, i) => <li><a href={`#${slug(r.title)}`} class="-ml-px flex gap-2 border-l-2 border-transparent py-1.5 pl-4 text-stone-600 transition hover:border-brand-500 hover:text-brand-700"><span class="tabular-nums text-stone-500">{String(i + 1).padStart(2, '0')}</span>{short[i]}</a></li>)}
                    <li><a href="#compared" class="-ml-px flex gap-2 border-l-2 border-transparent py-1.5 pl-4 text-stone-600 transition hover:border-brand-500 hover:text-brand-700"><span class="tabular-nums text-stone-500">&rarr;</span>Compared</a></li>
                </ol>
            </nav>
        </aside>

        <div class="min-w-0 space-y-6">
            {reasons.map((r, i) => (
                <article id={slug(r.title)} class="scroll-mt-24 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                    <div class="grid gap-8 md:grid-cols-[1fr_15rem] md:items-center">
                        <div>
                            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gold-600"><span class="tabular-nums">{String(i + 1).padStart(2, '0')}</span><span class="h-px w-6 bg-gold-300" aria-hidden="true"></span>{short[i]}</p>
                            <h2 class="mt-3 text-xl font-semibold sm:text-2xl">{r.title}</h2>
                            <p class="mt-3 leading-relaxed text-stone-600">{r.text}</p>
                            <ul class="mt-5 space-y-2.5 text-sm text-stone-700">
                                {r.points.map((pt) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /><span>{pt}</span></li>)}
                            </ul>
                        </div>
                        <div class="hidden overflow-hidden rounded-xl md:block"><Illustration name={r.icon} /></div>
                    </div>
                </article>
            ))}

            <section id="compared" class="scroll-mt-24 pt-6">
                <h2 class="text-xl font-semibold sm:text-2xl">Compared with what many teams use today</h2>
                <p class="mt-2 text-stone-600">A plain look at running your customer work in spreadsheets, in separate tools, or in OrvynCRM.</p>
                <div class="mt-6 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
                    <table class="w-full min-w-[34rem] text-left text-sm">
                        <thead>
                            <tr class="border-b border-stone-200 bg-stone-50">
                                <th scope="col" class="px-5 py-4"><span class="sr-only">Capability</span></th>
                                {comparison.columns.map((c, i) => <th scope="col" class:list={['px-5 py-4 font-semibold', i === 2 ? 'bg-brand-50 text-brand-700' : 'text-stone-700']}>{c}</th>)}
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stone-100">
                            {comparison.rows.map(([label, cells]) => (
                                <tr>
                                    <th scope="row" class="px-5 py-4 font-medium text-stone-800">{label}</th>
                                    {cells.map((c, i) => <td class:list={['px-5 py-4', i === 2 ? 'bg-brand-50/60 font-medium text-brand-700' : 'text-stone-500']}>{i === 2 && <Icon name="check" class="mr-1.5 inline size-4 align-[-3px] text-brand-600" />}{c}</td>)}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- a quiet closing note, not a banner -->
            <aside class="flex flex-col items-start justify-between gap-4 rounded-2xl border border-gold-200 bg-gold-100/50 p-6 sm:flex-row sm:items-center">
                <div><p class="font-semibold text-ink">Not sure it fits your business?</p><p class="mt-1 text-sm text-stone-600">Tell us how you work today and we will show you how it would look in OrvynCRM.</p></div>
                <a href="/demo" class="btn-primary shrink-0">Request a demo</a>
            </aside>
        </div>
    </div>
</Base>
