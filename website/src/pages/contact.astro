---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { legal } from '../data/legal';

const ways = [
    { icon: 'calendar', title: 'Talk to us about OrvynCRM', text: 'See it with your own business in mind. A short walkthrough, no pressure.', cta: 'Request a demo', href: '/demo' },
    { icon: 'mail', title: 'Write to us', text: 'Questions about plans, security, privacy or anything else.', cta: site.contactEmail, href: `mailto:${site.contactEmail}` },
    { icon: 'users', title: 'Already a customer?', text: 'Sign in to your workspace. Administrators can message the platform team from inside the app.', cta: 'Sign in', href: `${site.appUrl}/login` },
];
---
<Base title="Contact" description="Get in touch with the OrvynCRM team: request a demo, ask a question or sign in.">
    <header class="border-b border-stone-200 bg-stone-100/60">
        <div class="container-page py-10 sm:py-14">
            <nav aria-label="Breadcrumb" class="text-xs text-stone-500"><a href="/" class="hover:text-brand-700">Home</a> <span aria-hidden="true">/</span> <span class="text-stone-700">Contact</span></nav>
            <h1 class="mt-4 max-w-3xl text-3xl font-semibold sm:text-4xl">We would like to hear from you</h1>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">Choose the way that suits you and we will get back to you.</p>
        </div>
    </header>

    <section class="container-page py-16">
        <div class="grid gap-5 md:grid-cols-3">
            {ways.map((w) => (
                <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-7 shadow-sm">
                    <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name={w.icon} class="size-5" /></span>
                    <h2 class="mt-4 text-lg font-semibold">{w.title}</h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{w.text}</p>
                    <a href={w.href} class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900 break-all">{w.cta} <Icon name="arrow" class="size-4 shrink-0" /></a>
                </article>
            ))}
        </div>

        {legal.address ? (
            <div class="mx-auto mt-12 max-w-md rounded-2xl border border-stone-200 bg-white p-6 text-center shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">Business address</p>
                <p class="mt-2 text-sm font-medium text-stone-800">{legal.entity}</p>
                <p class="whitespace-pre-line text-sm leading-relaxed text-stone-700">{legal.address}</p>
            </div>
        ) : null}
    </section>
</Base>
