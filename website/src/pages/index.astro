---
import Base from '../layouts/Base.astro';
import AppMock from '../components/AppMock.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Outcomes from '../components/Outcomes.astro';
import Team from '../components/Team.astro';
import ProductTour from '../components/ProductTour.astro';
import IntegrationsStrip from '../components/IntegrationsStrip.astro';
import SecurityBand from '../components/SecurityBand.astro';
import DocsBand from '../components/DocsBand.astro';
import { Image } from 'astro:assets';
import teamPhoto from '../assets/team-celebrating.jpg';
import { faq, features, reasons, site, steps } from '../data/site';
---
<Base>
    <section class="relative overflow-hidden bg-gradient-to-b from-[#fbf7ee] via-[#f6efe1] to-[#fbf9f5]">
        <div class="pointer-events-none absolute -right-24 -top-24 size-[30rem] rounded-full bg-gold-200/50 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -left-32 top-1/2 size-[26rem] rounded-full bg-brand-200/40 blur-3xl" aria-hidden="true"></div>
        <div class="container-page relative pb-16 pt-12 sm:pt-16 lg:pb-24">
            <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
                <div class="text-center lg:text-left">
                    <p class="inline-flex items-center gap-2 rounded-full border border-gold-300 bg-gold-100/70 px-3 py-1 text-xs font-semibold text-gold-600">{site.tagline}</p>
                    <h1 class="mt-6 text-4xl font-semibold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">The CRM that adapts to <span class="text-gradient">how you work</span></h1>
                    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-stone-600 lg:mx-0">Model your own records, automate the follow-ups, and reach people by e-mail and SMS, all in one place. Every company gets its own private space.</p>
                    <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
                        <a href="/demo" class="btn-primary !px-6 !py-3">Request a demo</a>
                        <a href="/features" class="btn-outline !px-6 !py-3">See what it does</a>
                    </div>
                    <p class="mt-5 text-sm text-stone-600"><a href={site.signupUrl} class="font-semibold text-brand-700 underline underline-offset-2 hover:text-brand-900" data-testid="hero-signup">Prefer to start on your own? Create your workspace</a></p>
                    <p class="mt-4 flex items-center justify-center gap-2 text-sm text-stone-500 lg:justify-start"><span class="text-gold-400" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>Made for teams who like their work to run itself</p>
                </div>

                <div class="relative">
                    <div class="absolute -bottom-4 -right-4 hidden h-full w-3/4 rounded-[2rem] bg-gold-200/70 sm:block" aria-hidden="true"></div>
                    <div class="relative overflow-hidden rounded-[2rem] shadow-2xl shadow-brand-900/25 ring-1 ring-black/5">
                        <Image src={teamPhoto} alt="A team celebrating a win together around a table with laptops" widths={[480, 640, 960, 1280, 1600]} sizes="(min-width: 1024px) 56vw, 92vw" loading="eager" fetchpriority="high" class="aspect-[4/3] h-full w-full object-cover object-[60%_30%]" />
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-900/25 via-transparent to-transparent" aria-hidden="true"></div>
                    </div>
                    <div class="absolute -left-3 top-8 flex items-center gap-2 rounded-xl bg-white px-3.5 py-2.5 text-xs font-medium text-stone-600 shadow-xl ring-1 ring-black/5 sm:-left-6" aria-hidden="true"><span class="grid size-7 place-items-center rounded-full bg-emerald-100 text-emerald-700">&#10003;</span><span><span class="block font-semibold text-ink">Deal won</span>Northwind, just now</span></div>
                    <div class="absolute -right-2 bottom-24 hidden items-center gap-2 rounded-xl bg-white px-3.5 py-2.5 text-xs font-medium text-stone-600 shadow-xl ring-1 ring-black/5 sm:-right-5 sm:flex" aria-hidden="true"><span class="grid size-7 place-items-center rounded-full bg-gold-100 text-gold-600">&#9733;</span><span><span class="block font-semibold text-ink">Customer happy</span>Follow-up sent on time</span></div>
                    <div class="absolute -bottom-5 left-8 flex items-center gap-2 rounded-xl bg-white px-3.5 py-2.5 text-xs font-medium text-stone-600 shadow-xl ring-1 ring-black/5" aria-hidden="true"><span class="grid size-7 place-items-center rounded-full bg-brand-100 text-brand-700">&#9889;</span><span><span class="block font-semibold text-ink">3 automations ran</span>while you were away</span></div>
                </div>
            </div>

            <div class="relative mx-auto mt-20 max-w-4xl">
                <AppMock />
            </div>
        </div>
    </section>

    <IntegrationsStrip />

    <section class="reveal container-page py-20" aria-labelledby="tour-title">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">A quick look</p>
            <h2 id="tour-title" class="mt-2 text-3xl font-semibold sm:text-4xl">See how a day in OrvynCRM goes</h2>
        </div>
        <div class="mt-10"><ProductTour /></div>
    </section>

    <section class="reveal container-page py-20">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">Everything in one place</p>
            <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Less juggling, more selling</h2>
            <p class="mt-4 text-stone-600">Contacts, your own record types, automations, messages and planning work together instead of living in five different tools.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {features.slice(0, 6).map((f) => <FeatureCard feature={f} />)}
        </div>
        <p class="mt-8 text-center"><a href="/features" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">All features <Icon name="arrow" class="size-4" /></a></p>
    </section>

    <section class="reveal bg-stone-100/70 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Why OrvynCRM</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Why teams choose it</h2>
                <p class="mt-4 text-stone-600">It fits how you work, the follow-ups happen on their own, and you can always see what happened.</p>
            </div>
            <div class="mt-12 grid gap-5 md:grid-cols-3">
                {reasons.slice(0, 3).map((r) => (
                    <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                        <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name={r.icon} class="size-5" /></span>
                        <h3 class="mt-4 text-base font-semibold">{r.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-600">{r.text}</p>
                    </article>
                ))}
            </div>
            <p class="mt-8 text-center"><a href="/why-orvyncrm" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">All six reasons <Icon name="arrow" class="size-4" /></a></p>
        </div>
    </section>

    <section class="reveal bg-gradient-to-b from-white to-brand-50/60 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Results you can see</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Work gets done. Customers notice.</h2>
                <p class="mt-4 text-stone-600">When follow-ups happen on time and nothing falls through the cracks, people feel looked after. That is what OrvynCRM is built for.</p>
            </div>
            <div class="mt-12"><Outcomes /></div>
        </div>
    </section>

    <section class="reveal container-page py-20">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">Made for people</p>
            <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">A tool your whole team will actually enjoy</h2>
            <p class="mt-4 text-stone-600">From the owner to the person answering the phone, everyone gets what they need to feel on top of their day.</p>
        </div>
        <div class="mt-12"><Team /></div>
    </section>

    <SecurityBand />

    <section class="reveal bg-stone-50 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Getting started</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Up and running in three steps</h2>
            </div>
            <ol class="mt-12 grid gap-6 md:grid-cols-3">
                {steps.map((s, i) => (
                    <li class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">{i + 1}</span>
                        <h3 class="mt-4 text-base font-semibold">{s.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-600">{s.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <DocsBand />

    <section class="reveal container-page pb-4">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-center text-3xl font-semibold">Questions, answered</h2>
            <div class="mt-8 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
                {faq.map((f) => (
                    <details class="group p-5">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-stone-900">{f.q}<span class="text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
                        <p class="mt-3 text-sm leading-relaxed text-stone-600">{f.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <CtaBand />
</Base>
