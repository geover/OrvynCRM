---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import FlowMock from '../components/FlowMock.astro';
import BlastMock from '../components/BlastMock.astro';
import BoardMock from '../components/BoardMock.astro';
import TabsMock from '../components/TabsMock.astro';
import WhatsNew from '../components/WhatsNew.astro';
import SignInMock from '../components/SignInMock.astro';
import SupportMock from '../components/SupportMock.astro';
import AppMock from '../components/AppMock.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Outcomes from '../components/Outcomes.astro';
import Team from '../components/Team.astro';
import ProductTour from '../components/ProductTour.astro';
import IntegrationsStrip from '../components/IntegrationsStrip.astro';
import SecurityBand from '../components/SecurityBand.astro';
import TrialNote from '../components/TrialNote.astro';
import DocsBand from '../components/DocsBand.astro';
import { Image } from 'astro:assets';
import teamPhoto from '../assets/team-celebrating.jpg';
import { faq, features, reasons, site, steps, changelog } from '../data/site';
---
<Base>
    <!-- hero: dark, a dotted grid, a big headline, and the product standing on a coloured stage that is cut off at the bottom -->
    <section class="relative isolate overflow-hidden bg-gradient-to-b from-[#0f1626] via-[#1d2a40] to-[#243a58] text-white">
        <div class="bg-dots pointer-events-none absolute inset-0 -z-10 opacity-50 [mask-image:radial-gradient(ellipse_at_50%_0%,black,transparent_70%)]" aria-hidden="true"></div>
        <div class="animate-float-slow pointer-events-none absolute -left-24 top-10 -z-10 size-96 rounded-full bg-brand-500/30 blur-3xl" aria-hidden="true"></div>
        <div class="animate-float pointer-events-none absolute -right-24 top-40 -z-10 size-96 rounded-full bg-gold-400/20 blur-3xl" aria-hidden="true"></div>

        <div class="container-page pt-14 text-center sm:pt-20">
            <p class="animate-rise mx-auto inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-xs font-semibold text-gold-200 backdrop-blur">{site.tagline}</p>
            <h1 class="display animate-rise mx-auto mt-6 max-w-4xl text-5xl leading-[1.02] !text-white sm:text-6xl lg:text-7xl" style="animation-delay:80ms">The CRM that adapts to <span class="bg-gradient-to-r from-gold-300 via-gold-200 to-sky-300 bg-clip-text text-transparent">how you work</span></h1>
            <p class="animate-rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-100 sm:text-xl" style="animation-delay:160ms">Model your own records, automate the follow-ups, and reach people by e-mail and SMS, all in one place. Every company gets its own private space.</p>
            <div class="animate-rise mt-9 flex flex-wrap justify-center gap-3" style="animation-delay:240ms">
                <a href={site.signupUrl} class="btn-accent !px-7 !py-3.5 text-base" data-testid="hero-signup">Start your free trial</a>
                <a href="/demo" class="btn-ghost-dark !px-7 !py-3.5 text-base">Request a demo</a>
            </div>
            <div class="animate-rise mx-auto mt-7 max-w-xl" style="animation-delay:320ms"><TrialNote tone="dark" compact /></div>
        </div>

        <div class="container-page relative mt-14">
            <div class="relative overflow-hidden rounded-t-[2rem] bg-gradient-to-br from-[#3f78bd] via-[#2f5f9a] to-[#1d3a63] px-4 pt-10 shadow-[0_-24px_90px_-24px_rgba(95,134,176,0.65)] sm:px-12 sm:pt-14">
                <div class="bg-dots pointer-events-none absolute inset-0 opacity-30 [mask-image:radial-gradient(ellipse_at_50%_0%,black,transparent_80%)]" aria-hidden="true"></div>
                <div class="relative mx-auto max-h-[22rem] max-w-4xl overflow-hidden sm:max-h-[26rem]">
                    <AppMock />
                </div>
                <div class="animate-float absolute left-3 top-24 hidden items-center gap-2 rounded-xl bg-white px-3.5 py-2.5 text-xs font-medium text-stone-600 shadow-2xl shadow-black/30 ring-1 ring-black/5 sm:left-10 sm:flex" aria-hidden="true"><span class="grid size-7 place-items-center rounded-full bg-emerald-100 text-emerald-700">&#10003;</span><span><b class="block text-stone-800">Deal won</b>Northwind, just now</span></div>
                <div class="animate-float-slow absolute right-3 top-40 hidden items-center gap-2 rounded-xl bg-white px-3.5 py-2.5 text-xs font-medium text-stone-600 shadow-2xl shadow-black/30 ring-1 ring-black/5 sm:right-10 sm:flex" aria-hidden="true"><span class="grid size-7 place-items-center rounded-full bg-gold-100 text-gold-600">&#9889;</span><span><b class="block text-stone-800">3 automations ran</b>while you were away</span></div>
            </div>
        </div>
    </section>

    <IntegrationsStrip />

    <WhatsNew />

    <section class="reveal container-page py-20" aria-labelledby="tour-title">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">A quick look</p>
            <h2 id="tour-title" class="mt-2 text-3xl font-semibold sm:text-4xl">See how a day in OrvynCRM goes</h2>
        </div>
        <div class="mt-10"><ProductTour /></div>
    </section>

    <!-- three stages: the product at work, each on its own colour -->
    <Stage tone="blue" id="automations">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-300">Automations</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">Follow-ups that run themselves</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-brand-100">Pick a trigger, add a wait, choose the actions. E-mails, texts, tags, tasks and webhooks go out on their own, and every run is written down.</p>
                <ul class="mt-6 space-y-3 text-brand-100">
                    {['Wait minutes, hours or days between steps', 'See the whole sequence as a timeline', 'Every run recorded, step by step'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 text-gold-300"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/docs/automations" class="btn-light mt-8">See how automations work</a>
            </div>
            <FlowMock />
        </div>
    </Stage>

    <Stage tone="gold" id="boards">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-200">Workflow boards</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">See it. Drag it. Done.</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-gold-100">Any record type becomes a board of columns. Move a card with your hand, open it to see everything about it, and write to the people on it without leaving the page.</p>
                <ul class="mt-6 space-y-3 text-gold-100">
                    {['Search and filters that reach every card, not just the visible ones', 'Open a card: details, contacts, files, activity and actions', 'Email or text the item or its contacts in one click'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 text-gold-300"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/docs/data-objects" class="btn-light mt-8">See how boards work</a>
            </div>
            <BoardMock />
        </div>
    </Stage>

    <Stage tone="violet" id="messages">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div class="order-last lg:order-first"><BlastMock /></div>
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-300">E-mail and SMS</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">Every send, in one view</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-violet-100">Email all or Text all to any search, then follow it: how many people it found, how many went out, which failed and why, and how many opened.</p>
                <ul class="mt-6 space-y-3 text-violet-100">
                    {['Templates and merge fields, like writing to one person', 'An unsubscribe link in every bulk e-mail', 'Failures with the reason, contact by contact'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 text-gold-300"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/docs/messaging" class="btn-light mt-8">See how messaging works</a>
            </div>
        </div>
    </Stage>

    <Stage tone="teal" id="your-pages">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div class="order-last lg:order-first"><TabsMock /></div>
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-300">Custom tabs and pages</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">Your tools, right where you work</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-teal-50">Add a tab to every contact, or a page to the main menu. Show a report, an invoice list or your team handbook, to everyone or only to the people you choose.</p>
                <ul class="mt-6 space-y-3 text-teal-50">
                    {['A web page that knows the contact, or who is looking', 'Or your own content, written in a rich text editor', 'Shown to everyone, or to chosen roles, groups and people'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 text-gold-300"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/docs/data-objects" class="btn-light mt-8">See how custom tabs work</a>
            </div>
        </div>
    </Stage>

    <Stage tone="berry" id="support">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-300">Support, built in</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">Help is one click away</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-rose-100">Report a problem from any page and follow it on a board until it is solved. Colleagues ask your own team with Contact support, in a chat that keeps every answer, so nothing is ever lost.</p>
                <ul class="mt-6 space-y-3 text-rose-100">
                    {['Support tickets with a priority, screenshots and where you were', 'A chat for your colleagues, answered by your administrators', 'Badges and notices the moment there is an answer'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/docs/support" class="btn-light mt-8">See how support works</a>
            </div>
            <SupportMock />
        </div>
    </Stage>

    <Stage tone="navy" id="sign-in">
        <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-gold-300">Security</p>
                <h2 class="display mt-3 text-4xl !text-white sm:text-5xl">Sign in the way you prefer</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-brand-100">Protect every account beyond the password, and let people use what they already have. Administrators can require it of everybody.</p>
                <ul class="mt-6 space-y-3 text-brand-100">
                    {['Two-step verification with an authenticator app', 'Passkeys: a fingerprint, face or device PIN', 'Google, Microsoft, GitHub or your own single sign-on'].map((t) => <li class="flex gap-3"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 text-gold-300"><Icon name="check" class="size-3" /></span>{t}</li>)}
                </ul>
                <a href="/security" class="btn-light mt-8">How we protect your data</a>
            </div>
            <SignInMock />
        </div>
    </Stage>

    <section class="reveal container-page py-20">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">Everything in one place</p>
            <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Less juggling, more <span class="text-gradient">selling</span></h2>
            <p class="mt-4 text-stone-600">Contacts, your own record types, boards, automations, messages and your own tabs work together instead of living in five different tools.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {features.slice(0, 6).map((f) => <FeatureCard feature={f} />)}
        </div>
        <p class="mt-8 text-center"><a href="/features" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">All features <Icon name="arrow" class="size-4" /></a></p>
    </section>

    <section class="reveal bg-stone-100/70 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Why OrvynCRM</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Why teams choose it</h2>
                <p class="mt-4 text-stone-600">It fits how you work, the follow-ups happen on their own, and you can always see what happened.</p>
            </div>
            <div class="mt-12 grid gap-5 md:grid-cols-3">
                {reasons.slice(0, 3).map((r) => (
                    <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                        <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name={r.icon} class="size-5" /></span>
                        <h3 class="mt-4 text-base font-semibold">{r.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-600">{r.text}</p>
                    </article>
                ))}
            </div>
            <p class="mt-8 text-center"><a href="/why-orvyncrm" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">All the reasons <Icon name="arrow" class="size-4" /></a></p>
        </div>
    </section>

    <section class="reveal bg-gradient-to-b from-white to-brand-50/60 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Results you can see</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Work gets done. Customers notice.</h2>
                <p class="mt-4 text-stone-600">When follow-ups happen on time and nothing falls through the cracks, people feel looked after. That is what OrvynCRM is built for.</p>
            </div>
            <div class="mt-12"><Outcomes /></div>
        </div>
    </section>

    <section class="reveal container-page py-20">
        <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow">Made for people</p>
            <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">A tool your whole team will actually enjoy</h2>
            <p class="mt-4 text-stone-600">From the owner to the person answering the phone, everyone gets what they need to feel on top of their day.</p>
        </div>
        <div class="mt-12"><Team /></div>
    </section>

    <SecurityBand />

    <section class="reveal bg-stone-50 py-20">
        <div class="container-page">
            <div class="mx-auto max-w-2xl text-center">
                <p class="eyebrow">Getting started</p>
                <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Up and running in three steps</h2>
            </div>
            <ol class="mt-12 grid gap-6 md:grid-cols-3">
                {steps.map((s, i) => (
                    <li class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                        <span class="grid size-9 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">{i + 1}</span>
                        <h3 class="mt-4 text-base font-semibold">{s.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-600">{s.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <DocsBand />

    <section class="reveal container-page pb-4">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-center text-3xl font-semibold">Questions, answered</h2>
            <div class="mt-8 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
                {faq.map((f) => (
                    <details class="group p-5">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-stone-900">{f.q}<span class="text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
                        <p class="mt-3 text-sm leading-relaxed text-stone-600">{f.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <CtaBand />
</Base>
