---
import Docs from '../../layouts/Docs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import { docs, offer } from '../../data/docs';
import { site } from '../../data/site';

const layers = [
    { title: 'The platform', text: 'The team that runs OrvynCRM looks after the service: the servers, the e-mail and text providers, plans and prices.' },
    { title: 'Your workspace', text: 'Your company gets a private workspace with its own database, its own people, its own data model and its own look. Nobody else can see it.' },
    { title: 'Your people and your data', text: 'Contacts are the people you deal with. Data objects are the other things your business tracks, linked to those people.' },
    { title: 'Work that runs by itself', text: 'Automations, e-mail, text, forms and webhooks turn your data into follow-ups, with a record of everything that happened.' },
];
---
<Docs title="Documentation" description="How OrvynCRM works, what you need to start, how to build automations, and everything you can do as a company: guides, reference and API.">
    <header class="max-w-3xl">
        <p class="eyebrow">Documentation</p>
        <h1 class="mt-2 text-3xl font-semibold sm:text-5xl">Everything OrvynCRM can do, <span class="text-gradient">and how to do it</span></h1>
        <p class="mt-4 text-lg text-stone-600">A guide for the people who use it, and a reference for the people who connect to it. Start with the overview below, or jump straight to what you need.</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="/docs/getting-started" class="btn-primary">Get started</a>
            <a href="/docs/automations" class="btn-outline">Build an automation</a>
            <a href="/docs/api" class="btn-outline">API for developers</a>
        </div>
    </header>

    <section aria-labelledby="how" class="mt-14 max-w-4xl scroll-mt-24">
        <h2 id="how" class="text-2xl font-semibold">How the system works</h2>
        <p class="mt-2 max-w-2xl text-stone-600">Four layers, from the service to the work it does for you.</p>
        <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {layers.map((l, n) => (
                <li class="rounded-2xl border border-stone-200 bg-white p-5">
                    <span class="grid size-7 place-items-center rounded-full bg-brand-600 text-xs font-semibold text-white" aria-hidden="true">{n + 1}</span>
                    <h3 class="mt-3 font-semibold text-ink">{l.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-stone-600">{l.text}</p>
                </li>
            ))}
        </ol>
    </section>

    <section aria-labelledby="start" class="mt-14 max-w-4xl scroll-mt-24">
        <h2 id="start" class="text-2xl font-semibold">What you need to start</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-stone-200 bg-white p-5"><h3 class="font-semibold text-ink">A work e-mail</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">Create an account, confirm your address and your workspace is ready, with a free trial.</p></div>
            <div class="rounded-2xl border border-stone-200 bg-white p-5"><h3 class="font-semibold text-ink">Your contacts</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">A CSV file or a Keap account if you have one. Or start from nothing.</p></div>
            <div class="rounded-2xl border border-stone-200 bg-white p-5"><h3 class="font-semibold text-ink">An idea of your business</h3><p class="mt-1 text-sm leading-relaxed text-stone-600">What you track besides people: deals, properties, courses. You will model it in minutes.</p></div>
        </div>
        <p class="mt-4 text-sm text-stone-600">Nothing to install, no mail server and no developer needed. <a href="/docs/getting-started" class="font-medium text-brand-700 underline">Read the first-day checklist</a>, or <a href={site.signupUrl} class="font-medium text-brand-700 underline">create an account</a>.</p>
    </section>

    <section aria-labelledby="offer" class="mt-14 scroll-mt-24">
        <h2 id="offer" class="text-2xl font-semibold">All you can do as a company</h2>
        <p class="mt-2 max-w-2xl text-stone-600">Every service, grouped the way you will use it. Each card leads to the page that explains it.</p>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
            {offer.map((o) => (
                <a href={`/docs/${o.page}`} class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-brand-200 hover:shadow-md">
                    <div class="-mx-2 -mt-2 overflow-hidden rounded-xl"><Illustration name={o.icon} /></div>
                    <h3 class="mt-5 text-base font-semibold text-ink group-hover:text-brand-700">{o.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-stone-600">{o.text}</p>
                    <ul class="mt-4 space-y-2 text-sm text-stone-600">
                        {o.points.map((p) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /><span>{p}</span></li>)}
                    </ul>
                    <span class="mt-5 text-sm font-semibold text-brand-700">Read the guide <span aria-hidden="true">&rarr;</span></span>
                </a>
            ))}
        </div>
    </section>

    <section aria-labelledby="pages" class="mt-14 max-w-4xl scroll-mt-24">
        <h2 id="pages" class="text-2xl font-semibold">All the guides</h2>
        <ul class="mt-5 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
            {docs.map((d) => (
                <li>
                    <a href={`/docs/${d.slug}`} class="flex items-start gap-4 p-4 transition hover:bg-brand-50/60">
                        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600"><Icon name={d.icon} class="size-4" /></span>
                        <span><span class="block font-semibold text-ink">{d.title}</span><span class="block text-sm text-stone-600">{d.summary}</span></span>
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <CtaBand title="Want a hand getting set up?" text="We will walk you through your own data model, your first automation and your import." />
</Docs>
