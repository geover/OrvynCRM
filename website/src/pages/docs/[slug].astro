---
import Docs from '../../layouts/Docs.astro';
import DocBlocks from '../../components/DocBlocks.astro';
import CtaBand from '../../components/CtaBand.astro';
import { inline } from '../../lib/inline';
import { docs } from '../../data/docs';

export function getStaticPaths() {
    return docs.map((page, i) => ({ params: { slug: page.slug }, props: { page, prev: docs[i - 1], next: docs[i + 1] } }));
}
const { page, prev, next } = Astro.props;
---
<Docs title={`${page.title}: documentation`} description={page.summary} current={page.slug} toc={page.sections.map((s) => ({ id: s.id, title: s.title }))}>
    <header class="max-w-3xl">
        <p class="eyebrow"><a href="/docs" class="hover:underline">Documentation</a></p>
        <h1 class="mt-2 text-3xl font-semibold sm:text-4xl"><span class="text-gradient">{page.title}</span></h1>
        <p class="mt-3 text-lg text-stone-600">{page.summary}</p>
    </header>

    <div class="mt-10 max-w-3xl space-y-14">
        {page.sections.map((s) => (
            <section aria-labelledby={s.id} class="scroll-mt-24">
                <h2 id={s.id} class="text-2xl font-semibold">{s.title}</h2>
                {s.lead && <p class="mt-2 text-stone-600" set:html={inline(s.lead)} />}
                <div class="mt-5"><DocBlocks blocks={s.blocks} /></div>
            </section>
        ))}
    </div>

    <nav aria-label="More documentation" class="mt-16 grid max-w-3xl gap-4 border-t border-stone-200 pt-8 sm:grid-cols-2">
        {prev ? <a href={`/docs/${prev.slug}`} class="rounded-xl border border-stone-200 bg-white p-4 transition hover:border-brand-200 hover:shadow-sm"><span class="text-xs font-semibold uppercase tracking-wider text-stone-500">Previous</span><span class="mt-1 block font-semibold text-ink">{prev.title}</span></a> : <span></span>}
        {next ? <a href={`/docs/${next.slug}`} class="rounded-xl border border-stone-200 bg-white p-4 text-right transition hover:border-brand-200 hover:shadow-sm"><span class="text-xs font-semibold uppercase tracking-wider text-stone-500">Next</span><span class="mt-1 block font-semibold text-ink">{next.title}</span></a> : <span></span>}
    </nav>
    <CtaBand compact title="Questions, or want a walkthrough?" text="We are happy to show you how it fits your business, or to help you set it up." />
</Docs>
