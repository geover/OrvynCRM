---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { faq, planLimits, plans, site } from '../data/site';
---
<Base title="Pricing" description="Plans for teams of every size, with clear limits you can raise when you need more.">
    <section class="bg-stone-50 py-16 sm:py-20">
        <div class="container-page max-w-3xl text-center">
            <p class="eyebrow">Pricing</p>
            <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Start small. Grow when you are ready.</h1>
            <p class="mt-5 text-lg text-stone-600">Every company has clear limits on users, data objects and automations. You can see how much you use and ask for more at any time.</p>
        </div>
    </section>

    <section class="container-page py-16">
        <div class="grid items-stretch gap-6 lg:grid-cols-3">
            {plans.map((p) => (
                <article class:list={['flex flex-col rounded-2xl border bg-white p-7 shadow-sm', p.featured ? 'border-brand-500 ring-1 ring-brand-500 shadow-lg' : 'border-stone-200']}>
                    {p.featured && <span class="mb-3 w-fit rounded-full bg-brand-600 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-white">Most popular</span>}
                    <h2 class="text-xl font-semibold">{p.name}</h2>
                    <p class="mt-1 text-sm text-stone-500">{p.blurb}</p>
                    <p class="mt-5 text-3xl font-semibold text-stone-900">{p.price}{p.unit && <span class="text-sm font-normal text-stone-500"> {p.unit}</span>}</p>
                    <ul class="mt-6 space-y-3 text-sm text-stone-700">
                        {p.includes.map((i) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /><span>{i}</span></li>)}
                    </ul>
                    <a href={p.href === 'signup' ? site.signupUrl : '/demo'} class:list={['mt-8', p.featured ? 'btn-primary' : 'btn-outline']}>{p.cta}</a>
                </article>
            ))}
        </div>
        <p class="mt-6 text-center text-xs text-stone-500">Need more users, data objects or automations than your plan includes? Administrators can request them inside the app, with the price shown before you confirm.</p>
    </section>

    <section class="container-page pb-16" aria-labelledby="compare-title">
        <h2 id="compare-title" class="text-center text-2xl font-semibold">Compare the plans</h2>
        <div class="mx-auto mt-8 max-w-4xl overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
            <table class="w-full min-w-[34rem] text-left text-sm">
                <thead><tr class="border-b border-stone-200 bg-stone-50"><th scope="col" class="px-5 py-4"><span class="sr-only">Feature</span></th>{planLimits.columns.map((c, i) => <th scope="col" class:list={['px-5 py-4 font-semibold', i === 1 ? 'bg-brand-50 text-brand-700' : 'text-stone-700']}>{c}</th>)}</tr></thead>
                <tbody class="divide-y divide-stone-100">
                    {planLimits.rows.map(([label, cells]) => (
                        <tr><th scope="row" class="px-5 py-3.5 font-medium text-stone-800">{label}</th>{cells.map((c, i) => <td class:list={['px-5 py-3.5', i === 1 ? 'bg-brand-50/60 font-medium text-brand-700' : 'text-stone-600']}>{c || <span class="text-stone-300" aria-label="Not included">&mdash;</span>}</td>)}</tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="container-page pb-4">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-center text-2xl font-semibold">Common questions</h2>
            <div class="mt-8 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
                {faq.slice(0, 3).map((f) => (
                    <details class="group p-5">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-stone-900">{f.q}<span class="text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
                        <p class="mt-3 text-sm leading-relaxed text-stone-600">{f.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <CtaBand />
</Base>
