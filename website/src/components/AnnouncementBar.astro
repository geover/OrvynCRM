---
import { changelog } from '../data/site';
const latest = changelog[0];
---
<div id="announce" class="relative hidden bg-brand-900 text-white" data-key={latest.title} role="region" aria-label="Announcement">
    <div class="container-page flex items-center justify-center gap-3 py-2 pr-10 text-xs sm:text-sm">
        <span class="rounded-full bg-gold-300 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#1d2433]">New</span>
        <a href="/changelog" class="truncate font-medium text-white/90 underline-offset-4 hover:text-white hover:underline">{latest.title} <span aria-hidden="true">&rarr;</span></a>
    </div>
    <button type="button" id="announce-close" class="absolute right-3 top-1/2 grid size-7 -translate-y-1/2 place-items-center rounded-full text-white/70 hover:bg-white/10 hover:text-white" aria-label="Dismiss the announcement">&times;</button>
</div>
<script>
    // shown until the person closes it; a newer announcement shows again
    const bar = document.getElementById('announce');
    if (bar) {
        let seen = null;
        try { seen = localStorage.getItem('orvyn-announce'); } catch { /* private mode: just show it */ }
        if (seen !== bar.dataset.key) bar.classList.remove('hidden');
        document.getElementById('announce-close')?.addEventListener('click', () => {
            bar.classList.add('hidden');
            try { localStorage.setItem('orvyn-announce', bar.dataset.key ?? ''); } catch { /* ignore */ }
        });
    }
</script>
