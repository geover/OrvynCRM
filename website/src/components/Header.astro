---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === href || path.startsWith(`${href}/`);
const inProduct = (i: (typeof nav)[number]) => !!i.children?.some((c) => current(c.href));
---
<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-white/85 backdrop-blur transition-shadow" data-header>
    <div class="container-page flex h-16 items-center justify-between gap-4 lg:gap-6">
        <a href="/" class="flex items-center gap-2" aria-label={`${site.name} home`}><img src="/brand/orvyn-logo-blend.svg" alt={site.name} class="dark-hide h-8 w-auto" width="128" height="32" /><img src="/brand/orvyn-logo-on-dark.svg" alt={site.name} class="hidden h-8 w-auto dark-show" width="128" height="32" /></a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
            {nav.map((i) => i.children ? (
                <div class="relative" data-dropdown>
                    <button type="button" aria-expanded="false" aria-haspopup="true" data-dropdown-button
                        class:list={['flex items-center gap-1 whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition', inProduct(i) ? 'text-brand-700' : 'text-stone-600 hover:text-stone-900']}>
                        {i.label}<svg viewBox="0 0 20 20" class="size-4" aria-hidden="true" fill="currentColor"><path d="M5.5 7.5l4.5 4.5 4.5-4.5z" /></svg>
                    </button>
                    <div class="invisible absolute left-0 top-full z-50 w-[22rem] pt-2 opacity-0 transition data-[open=true]:visible data-[open=true]:opacity-100" data-dropdown-panel role="menu">
                        <div class="rounded-2xl border border-stone-200 bg-white p-2 shadow-xl shadow-stone-900/10">
                            {i.children.map((c) => (
                                <a href={c.href} role="menuitem" class="flex gap-3 rounded-xl p-3 transition hover:bg-brand-50">
                                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600"><Icon name={c.icon} class="size-4" /></span>
                                    <span><span class="block text-sm font-semibold text-ink">{c.label}</span><span class="block text-xs leading-relaxed text-stone-500">{c.text}</span></span>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            ) : (
                <a href={i.href} aria-current={current(i.href) ? 'page' : undefined}
                    class:list={['whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition', current(i.href) ? 'text-brand-700' : 'text-stone-600 hover:text-stone-900']}>{i.label}</a>
            ))}
        </nav>

        <div class="hidden items-center gap-2 md:flex">
            <button type="button" class="theme-toggle grid size-9 place-items-center rounded-lg text-stone-600 transition hover:bg-stone-100" aria-label="Switch between light and dark" data-testid="theme-toggle"><Icon name="moon" class="size-5 dark-hide" /><Icon name="sun" class="hidden size-5 dark-show" /></button>
            <a href={`${site.appUrl}/login`} class="btn whitespace-nowrap text-stone-700 hover:bg-stone-100">Sign in</a>
            <a href={site.signupUrl} class="btn-outline hidden whitespace-nowrap lg:inline-flex" data-testid="nav-signup">Start free trial</a>
            <a href="/demo" class="btn-primary whitespace-nowrap">Request a demo</a>
        </div>

        <button type="button" class="grid size-10 place-items-center rounded-lg text-stone-700 hover:bg-stone-100 md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
            <Icon name="menu" class="size-6" />
        </button>
    </div>

    <div id="mobile-menu" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-stone-200 bg-white md:hidden" data-menu>
        <div class="container-page flex flex-col gap-1 py-3">
            {nav.map((i) => i.children ? (
                <div class="py-1">
                    <p class="px-3 pb-1 pt-2 text-[11px] font-semibold uppercase tracking-wider text-stone-500">{i.label}</p>
                    {i.children.map((c) => <a href={c.href} class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-stone-700 hover:bg-stone-50"><Icon name={c.icon} class="size-4 text-brand-600" />{c.label}</a>)}
                </div>
            ) : (
                <a href={i.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-stone-700 hover:bg-stone-50">{i.label}</a>
            ))}
            <div class="mt-2 grid grid-cols-2 gap-2 border-t border-stone-100 pt-3">
                <button type="button" class="theme-toggle btn-outline col-span-2" aria-label="Switch between light and dark"><Icon name="moon" class="size-4 dark-hide" /><Icon name="sun" class="hidden size-4 dark-show" /> <span class="dark-hide">Dark mode</span><span class="hidden dark-show">Light mode</span></button>
                <a href={`${site.appUrl}/login`} class="btn-outline">Sign in</a>
                <a href={site.signupUrl} class="btn-outline">Start free trial</a>
                <a href="/demo" class="btn-primary col-span-2">Request a demo</a>
            </div>
        </div>
    </div>
</header>

<script>
    // mobile menu
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    button?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        button.setAttribute('aria-expanded', String(open));
    });

    // the Product panel: opens on hover and on keyboard focus or click, closes on Escape or a click elsewhere
    document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((root) => {
        const toggle = root.querySelector<HTMLButtonElement>('[data-dropdown-button]')!;
        const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]')!;
        let closeTimer: number | undefined;
        const set = (open: boolean) => { panel.dataset.open = String(open); toggle.setAttribute('aria-expanded', String(open)); };
        root.addEventListener('mouseenter', () => { clearTimeout(closeTimer); set(true); });
        root.addEventListener('mouseleave', () => { closeTimer = window.setTimeout(() => set(false), 120); });
        toggle.addEventListener('click', () => set(panel.dataset.open !== 'true'));
        root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) set(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); toggle.focus(); } });
        document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) set(false); });
    });

    // a hairline shadow once the page has scrolled
    const header = document.querySelector<HTMLElement>('[data-header]');
    const onScroll = () => header?.classList.toggle('shadow-sm', window.scrollY > 8);
    requestAnimationFrame(onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
</script>
