---
interface Props {
    eyebrow?: string;
    /** The first words of the heading. May be empty when the whole heading is the highlight. */
    title?: string;
    /** The closing words of the heading, drawn in the brand gradient. */
    highlight?: string;
    lead?: string;
    /** The page name for the breadcrumb ("Home / Security"). Leave out on pages that need none. */
    crumb?: string;
    /** A small line under the lead, such as the dates on a legal page. */
    meta?: string;
}
const { eyebrow, title, highlight, lead, crumb, meta } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-gradient-to-b from-[#0f1626] via-[#1d2a40] to-[#243a58] py-14 text-white sm:py-20">
    <div class="bg-dots pointer-events-none absolute inset-0 -z-10 opacity-40 [mask-image:radial-gradient(ellipse_at_50%_0%,black,transparent_72%)]" aria-hidden="true"></div>
    <div class="animate-float-slow pointer-events-none absolute -right-24 -top-24 -z-10 size-80 rounded-full bg-gold-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="animate-float pointer-events-none absolute -left-24 top-24 -z-10 size-72 rounded-full bg-brand-500/25 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative max-w-3xl text-center">
        {crumb && <nav aria-label="Breadcrumb" class="mb-4 text-xs text-white/60"><a href="/" class="hover:text-white">Home</a> <span aria-hidden="true">/</span> <span class="text-white/85">{crumb}</span></nav>}
        {eyebrow && <p class="text-xs font-bold uppercase tracking-widest text-gold-300">{eyebrow}</p>}
        <h1 class="display animate-rise mt-2 text-4xl !text-white sm:text-5xl lg:text-6xl">{title}{title && highlight && " "}{highlight && <span class="bg-gradient-to-r from-gold-300 via-gold-200 to-sky-300 bg-clip-text text-transparent">{highlight}</span>}</h1>
        {lead && <p class="animate-rise mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-brand-100" style="animation-delay:100ms">{lead}</p>}
        {meta && <p class="mt-3 text-sm text-white/60">{meta}</p>}
        <div class="mt-7 flex flex-wrap justify-center gap-3 empty:hidden"><slot /></div>
    </div>
</section>
