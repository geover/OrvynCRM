---
import Icon from './Icon.astro';
import { securityPoints } from '../data/site';

interface Props { all?: boolean }
const { all = false } = Astro.props;
const points = all ? securityPoints : securityPoints.slice(0, 4);
---
<section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-[#243a58] to-brand-700 py-20 text-white">
    <div class="pointer-events-none absolute -right-24 -top-24 size-96 rounded-full bg-gold-400/15 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative">
        <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto]">
            <div class="max-w-2xl">
                <p class="text-xs font-semibold uppercase tracking-widest text-gold-300">Security and privacy</p>
                <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Your customers' information deserves care</h2>
                <p class="mt-4 text-brand-100">How OrvynCRM is built to keep each company's data apart, protected and under its own control.</p>
            </div>
            {!all && <a href="/security" class="btn-light shrink-0">How we protect your data</a>}
        </div>
        <div class:list={['mt-12 grid gap-5 sm:grid-cols-2', 'lg:grid-cols-4']}>
            {points.map((p) => (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
                    <span class="grid size-10 place-items-center rounded-xl bg-white/10 text-gold-300"><Icon name={p.icon} class="size-5" /></span>
                    <h3 class="mt-4 text-base font-semibold text-white">{p.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-brand-100">{p.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>
