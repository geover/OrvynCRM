---
import Icon from './Icon.astro';

// A tabbed tour of the product: four drawn screens with sample data. Replace a panel with a real screenshot when you have one.
const tabs = [
    { id: 'contacts', label: 'Contacts', icon: 'users', title: 'Every person, with everything around them', text: 'Notes, tasks, messages, relationships and files on one record, with search and saved queries to find anyone in seconds.' },
    { id: 'automations', label: 'Automations', icon: 'zap', title: 'Follow-ups that run by themselves', text: 'Pick a condition, choose the actions and switch it on. Every run is recorded, step by step.' },
    { id: 'messages', label: 'Messages', icon: 'mail', title: 'E-mail and SMS from the same place', text: 'Write once with templates, send to one person or many, and see opens, clicks and delivery on the record.' },
    { id: 'dashboard', label: 'Dashboard', icon: 'calendar', title: 'See the day at a glance', text: 'Widgets built from your own queries, your tasks and what is coming up, arranged the way you like.' },
];
const people = [['Maria Santos', 'Northwind', 'Customer', 'bg-emerald-50 text-emerald-700'], ['James Okafor', 'Lumen & Co', 'Lead', 'bg-gold-100 text-gold-600'], ['Aiko Tanaka', 'Harbor Labs', 'Customer', 'bg-emerald-50 text-emerald-700'], ['Lucas Meyer', 'Brightside', 'Prospect', 'bg-brand-50 text-brand-700'], ['Sofia Rossi', 'Verde Studio', 'Lead', 'bg-gold-100 text-gold-600']];
---
<div data-tour>
    <div class="flex justify-center">
        <div class="inline-flex max-w-full flex-wrap justify-center gap-1 rounded-2xl border border-stone-200 bg-white p-1 shadow-sm" role="tablist" aria-label="Product tour">
            {tabs.map((t, i) => (
                <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}
                    class="flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium text-stone-600 transition hover:text-stone-900 aria-selected:bg-brand-600 aria-selected:text-white aria-selected:shadow-sm">
                    <Icon name={t.icon} class="size-4" />{t.label}
                </button>
            ))}
        </div>
    </div>

    <div class="mt-10 grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div class="min-h-[8.5rem]">
            {tabs.map((t, i) => (
                <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-text={t.id} hidden={i !== 0}>
                    <h3 class="text-2xl font-semibold sm:text-3xl">{t.title}</h3>
                    <p class="mt-4 leading-relaxed text-stone-600">{t.text}</p>
                    <a href="/features" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900">Explore features <Icon name="arrow" class="size-4" /></a>
                </div>
            ))}
        </div>

        <!-- the screen -->
        <div class="relative">
            <div class="absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-gold-100 via-brand-100/60 to-transparent" aria-hidden="true"></div>
            <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-xl shadow-stone-900/10" role="img" aria-label="Sample product screen">
                <div class="flex items-center gap-1.5 border-b border-stone-200 bg-stone-50 px-4 py-2.5"><span class="size-2.5 rounded-full bg-stone-300"></span><span class="size-2.5 rounded-full bg-stone-300"></span><span class="size-2.5 rounded-full bg-stone-300"></span><span class="ml-3 rounded-md bg-white px-3 py-0.5 text-[11px] text-stone-500 ring-1 ring-stone-200">app.yourcompany.com</span></div>
                <div class="relative h-[22rem] sm:h-[24rem]">
                    <!-- contacts -->
                    <div data-screen="contacts" class="absolute inset-0 p-5 text-[12px]">
                        <div class="flex items-center justify-between"><p class="text-sm font-semibold text-ink">Contacts</p><span class="rounded-lg bg-brand-600 px-3 py-1.5 font-medium text-white">+ New contact</span></div>
                        <div class="mt-3 rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-stone-500">Search by name, e-mail, tag or company…</div>
                        <ul class="mt-3 divide-y divide-stone-100">
                            {people.map(([n, c, s, badge]) => (
                                <li class="flex items-center gap-3 py-2.5"><span class="grid size-8 place-items-center rounded-full bg-brand-100 font-semibold text-brand-700">{n.split(' ').map((w) => w[0]).join('')}</span><span class="min-w-0 flex-1"><span class="block truncate font-medium text-ink">{n}</span><span class="block truncate text-stone-500">{c}</span></span><span class:list={['rounded-full px-2 py-0.5 font-medium', badge]}>{s}</span></li>
                            ))}
                        </ul>
                    </div>
                    <!-- automations -->
                    <div data-screen="automations" class="absolute inset-0 hidden p-5 text-[12px]">
                        <div class="flex items-center justify-between"><p class="text-sm font-semibold text-ink">New customer follow-up</p><span class="rounded-full bg-emerald-50 px-2.5 py-0.5 font-medium text-emerald-700">Active</span></div>
                        <div class="mt-4 rounded-xl border border-stone-200 p-3"><p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">If this</p><p class="mt-1 font-medium text-ink">A contact becomes a <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-700">Customer</span></p></div>
                        <div class="mx-auto h-4 w-px bg-stone-300"></div>
                        <ul class="space-y-2">
                            {[['mail', 'Send e-mail', 'Welcome and next steps', 'bg-brand-50 text-brand-600'], ['calendar', 'Create task', 'Kick-off call for the owner', 'bg-gold-100 text-gold-600'], ['link', 'Call webhook', 'Tell the billing system', 'bg-stone-100 text-stone-600']].map(([ic, t, s, c]) => (
                                <li class="flex items-center gap-3 rounded-xl border border-stone-200 p-3"><span class:list={['grid size-8 place-items-center rounded-lg', c]}><Icon name={ic} class="size-4" /></span><span class="flex-1"><span class="block font-medium text-ink">{t}</span><span class="block text-stone-500">{s}</span></span><span class="grid size-5 place-items-center rounded-full bg-emerald-500 text-white"><Icon name="check" class="size-3" /></span></li>
                            ))}
                        </ul>
                    </div>
                    <!-- messages -->
                    <div data-screen="messages" class="absolute inset-0 hidden grid-cols-[1fr_9rem] gap-4 p-5 text-[12px]">
                        <div class="rounded-xl border border-stone-200">
                            <div class="border-b border-stone-100 px-3 py-2 text-stone-500">To: <span class="text-ink">Maria Santos</span></div>
                            <div class="border-b border-stone-100 px-3 py-2 text-stone-500">Subject: <span class="font-medium text-ink">Welcome aboard</span></div>
                            <div class="space-y-2 px-3 py-3 text-stone-600"><p>Hi Maria,</p><p>Thanks for choosing us. Here is what happens next and who to call if you need anything.</p><p class="h-2 w-2/3 rounded bg-stone-100"></p><p class="h-2 w-1/2 rounded bg-stone-100"></p></div>
                            <div class="flex items-center justify-between border-t border-stone-100 px-3 py-2"><span class="rounded bg-stone-100 px-2 py-0.5 text-stone-500">Template: Welcome</span><span class="rounded-lg bg-brand-600 px-3 py-1 font-medium text-white">Send</span></div>
                        </div>
                        <div class="space-y-2.5">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Delivery</p>
                            <div class="rounded-lg bg-emerald-50 px-2.5 py-2 text-emerald-700"><p class="font-semibold">Delivered</p><p class="text-[11px]">Opened twice</p></div>
                            <div class="rounded-2xl rounded-bl-sm bg-brand-600 px-3 py-2 text-white">Your order is ready. Reply to chat.</div>
                            <div class="rounded-lg bg-stone-100 px-2.5 py-2 text-stone-500">SMS sent</div>
                        </div>
                    </div>
                    <!-- dashboard -->
                    <div data-screen="dashboard" class="absolute inset-0 hidden p-5 text-[12px]">
                        <div class="grid grid-cols-3 gap-3">
                            {[['New contacts', '48', 'text-brand-700'], ['Tasks due today', '12', 'text-gold-600'], ['Messages sent', '326', 'text-emerald-700']].map(([l, v, c]) => (
                                <div class="rounded-xl border border-stone-200 p-3"><p class="text-stone-500">{l}</p><p class:list={['mt-1 text-2xl font-semibold', c]}>{v}</p></div>
                            ))}
                        </div>
                        <div class="mt-3 grid grid-cols-[1.4fr_1fr] gap-3">
                            <div class="rounded-xl border border-stone-200 p-3"><p class="font-medium text-ink">Deals by stage</p><div class="mt-3 flex h-24 items-end gap-2">{[40, 62, 50, 78, 66, 92].map((h, i) => <div class:list={['flex-1 rounded-t', i === 5 ? 'bg-gradient-to-t from-brand-600 to-gold-400' : 'bg-brand-100']} style={`height:${h}%`}></div>)}</div></div>
                            <div class="rounded-xl border border-stone-200 p-3"><p class="font-medium text-ink">Today</p><ul class="mt-2 space-y-2 text-stone-500">{['Call Maria', 'Send proposal', 'Review renewals'].map((t) => <li class="flex items-center gap-2"><span class="size-3 rounded border border-stone-300"></span>{t}</li>)}</ul></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <p class="mt-6 text-center text-xs text-stone-500">Illustrated screens with sample data.</p>
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-tour]').forEach((root) => {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
        const select = (id: string) => {
            tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
            root.querySelectorAll<HTMLElement>('[data-text]').forEach((p) => { p.hidden = p.dataset.text !== id; });
            root.querySelectorAll<HTMLElement>('[data-screen]').forEach((s) => {
                const on = s.dataset.screen === id;
                s.classList.toggle('hidden', !on);
                s.classList.toggle('grid', on && id === 'messages');
            });
        };
        tabs.forEach((t, i) => {
            t.addEventListener('click', () => select(t.dataset.tab!));
            t.addEventListener('keydown', (e) => {
                const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
                if (next >= 0) { const target = tabs[(next + tabs.length) % tabs.length]; target.focus(); select(target.dataset.tab!); }
            });
        });
        // the tour moves on by itself until the visitor takes over
        let index = 0;
        let timer: number | undefined = window.setInterval(() => { index = (index + 1) % tabs.length; select(tabs[index].dataset.tab!); }, 6000);
        const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
        root.addEventListener('pointerdown', stop, { once: true });
        root.addEventListener('focusin', stop, { once: true });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) stop();
    });
</script>
