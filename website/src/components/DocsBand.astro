---
import Icon from './Icon.astro';
import { withAppAddress } from '../lib/inline';

const guides = [
    ['Getting started', '/docs/getting-started'],
    ['Automations and their actions', '/docs/automations'],
    ['E-mail and text messages', '/docs/messaging'],
    ['API for developers', '/docs/api'],
];
const sample = withAppAddress(`curl -X POST https://YOUR-APP-ADDRESS/api/v1/contacts \\
  -H "Authorization: Bearer $TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{"first_name":"Maria","last_name":"Santos","email":"maria@example.com"}'`);
---
<section class="reveal container-page py-20" aria-labelledby="docs-band-title">
    <div class="grid items-center gap-10 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm sm:p-12 lg:grid-cols-2">
        <div>
            <p class="eyebrow">Documentation</p>
            <h2 id="docs-band-title" class="mt-2 text-3xl font-semibold sm:text-4xl">Learn it in an afternoon, connect it in an hour</h2>
            <p class="mt-4 text-stone-600">Guides for the people who use OrvynCRM, and a reference for the people who connect to it: how to set up your data, build automations, send messages and call the API.</p>
            <ul class="mt-6 space-y-2.5 text-sm">
                {guides.map(([label, href]) => (
                    <li><a href={href} class="group flex items-center gap-2.5 font-medium text-stone-700 transition hover:text-brand-700"><Icon name="check" class="size-4 shrink-0 text-brand-600" />{label}<span class="text-brand-600 opacity-0 transition group-hover:opacity-100" aria-hidden="true">&rarr;</span></a></li>
                ))}
            </ul>
            <a href="/docs" class="btn-primary mt-8">Read the documentation</a>
        </div>
        <figure class="overflow-hidden rounded-2xl border border-stone-800 bg-[#1d2433] text-stone-100 shadow-xl shadow-stone-900/10">
            <figcaption class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5 text-xs text-stone-300">
                <span class="size-2.5 rounded-full bg-white/20" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-white/20" aria-hidden="true"></span><span class="size-2.5 rounded-full bg-white/20" aria-hidden="true"></span>
                <span class="ml-2">Create a contact with the API</span>
            </figcaption>
            <pre class="overflow-x-auto p-5 text-[13px] leading-relaxed" tabindex="0"><code>{sample}</code></pre>
        </figure>
    </div>
</section>
