---
import Icon from './Icon.astro';
import Illustration from './Illustration.astro';
import type { Feature } from '../data/site';

interface Props { feature: Feature; showPoints?: boolean; level?: 'h2' | 'h3' }
const { feature, showPoints = false, level: Heading = 'h3' } = Astro.props;
---
<article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-brand-200 hover:shadow-md">
    <div class="-mx-2 -mt-2 overflow-hidden rounded-xl"><Illustration name={feature.icon} /></div>
    <Heading class="mt-5 text-base font-semibold">{feature.title}</Heading>
    <p class="mt-2 text-sm leading-relaxed text-stone-600">{feature.text}</p>
    {showPoints && (
        <ul class="mt-4 space-y-2 text-sm text-stone-600">
            {feature.points.map((p) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /><span>{p}</span></li>)}
        </ul>
    )}
</article>
