---
// A drawn picture of the product (no screenshot needed). Replace it with a real screenshot in /public when you have one.
---
<div class="overflow-hidden rounded-xl border border-white/10 bg-white shadow-2xl shadow-brand-900/40 ring-1 ring-black/5" role="img" aria-label="Preview of the OrvynCRM contact page">
    <div class="flex items-center gap-1.5 border-b border-stone-200 bg-stone-50 px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-stone-300"></span><span class="size-2.5 rounded-full bg-stone-300"></span><span class="size-2.5 rounded-full bg-stone-300"></span>
        <span class="ml-3 rounded-md bg-white px-3 py-0.5 text-[11px] text-stone-500 ring-1 ring-stone-200">app.yourcompany.com / contacts</span>
    </div>
    <div class="grid grid-cols-1 text-left text-[11px] sm:grid-cols-[11rem_1fr]">
        <div class="hidden space-y-1 border-r border-stone-200 bg-stone-50 p-3 sm:block">
            <div class="mb-2 flex items-center gap-2"><span class="size-5 rounded-md bg-gradient-to-br from-brand-500 to-gold-400"></span><span class="font-semibold text-stone-800">Orvyn</span></div>
            {['Dashboard', 'Contacts', 'Deals', 'Boards', 'My tasks', 'Schedules'].map((n, i) => (
                <div class:list={['rounded-md px-2 py-1.5', i === 1 ? 'bg-brand-50 font-medium text-brand-700' : 'text-stone-500']}>{n}</div>
            ))}
        </div>
        <div class="min-w-0 p-4">
            <div class="flex items-center justify-between">
                <div><div class="text-sm font-semibold text-stone-900">Maria Santos</div><div class="text-stone-500">Head of Operations, Northwind</div></div>
                <span class="rounded-full bg-emerald-50 px-2 py-0.5 font-medium text-emerald-700">Customer</span>
            </div>
            <div class="mt-3 flex gap-1 border-b border-stone-200 text-stone-500">
                {['Overview', 'Notes', 'Communications', 'Deals'].map((t, i) => <span class:list={['px-2.5 pb-2', i === 0 && 'border-b-2 border-brand-600 font-medium text-brand-700']}>{t}</span>)}
            </div>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <div class="rounded-lg border border-stone-200 p-3">
                    <div class="mb-1.5 font-semibold text-stone-700">Details</div>
                    <div class="space-y-1 text-stone-500"><div class="flex justify-between"><span>E-mail</span><span class="text-stone-800">maria@northwind.test</span></div><div class="flex justify-between"><span>Phone</span><span class="text-stone-800">+1 555 010 2030</span></div><div class="flex justify-between"><span>Owner</span><span class="text-stone-800">Alex Rivera</span></div></div>
                </div>
                <div class="rounded-lg border border-stone-200 p-3">
                    <div class="mb-1.5 font-semibold text-stone-700">Automation ran</div>
                    <div class="space-y-1.5 text-stone-500">
                        <div class="flex items-center gap-2"><span class="grid size-4 place-items-center rounded-full bg-emerald-100 text-emerald-700">&#10003;</span>Welcome e-mail sent</div>
                        <div class="flex items-center gap-2"><span class="grid size-4 place-items-center rounded-full bg-emerald-100 text-emerald-700">&#10003;</span>Tag "New customer" added</div>
                        <div class="flex items-center gap-2"><span class="grid size-4 place-items-center rounded-full bg-emerald-100 text-emerald-700">&#10003;</span>Task for Alex created</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
