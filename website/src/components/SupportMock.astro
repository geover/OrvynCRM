---
// A picture of the support board: three columns by status, a ticket that is lifted, tilted and carried to the next column on a loop, and the chat a colleague gets an answer in.
import Icon from './Icon.astro';

const cols = [
    { name: 'Needs us', color: '#ef4444', n: 3, cards: [['Export stops halfway', 'Acme Co', 'MS', '#ef4444'], ['Cannot add a user', 'Lumen', 'JO', '#f97316']] },
    { name: 'Waiting', color: '#f59e0b', n: 2, cards: [['Invoice question', 'Harbor Labs', 'AT', '#94a3b8']] },
    { name: 'Resolved', color: '#10b981', n: 5, cards: [['Login loop fixed', 'Verde', 'SR', '#cbd5e1']] },
];
---
<div class="relative mx-auto w-full max-w-lg pb-12" role="img" aria-label="A support board with three columns: Needs us, Waiting and Resolved. A ticket is lifted, tilted and carried to the next column, and a chat window shows a question and its answer.">
    <div class="rounded-2xl bg-white p-3 shadow-2xl shadow-black/30 ring-1 ring-black/5">
        <div class="flex items-center justify-between gap-2 px-1 pb-2 text-[11px]">
            <span class="flex items-center gap-1.5 font-semibold text-ink"><span class="grid size-5 place-items-center rounded-md bg-rose-100 text-rose-600"><Icon name="lifebuoy" class="size-3" /></span>Support tickets</span>
            <span class="rounded-md bg-stone-100 px-2 py-0.5 text-stone-500">Find a ticket…</span>
        </div>
        <div class="grid grid-cols-3 gap-3 text-[11px]">
            {cols.map((c, ci) => (
                <div class="rounded-xl bg-stone-100/80 pb-2" style={`border-top:4px solid ${c.color}`}>
                    <div class="flex items-center justify-between px-2.5 py-2"><span class="font-semibold text-ink">{c.name}</span><span class="rounded-full bg-white px-1.5 text-stone-500">{c.n}</span></div>
                    <div class="space-y-2 px-2">
                        {c.cards.map(([title, who, init, prio], i) => (
                            <div class:list={['rounded-lg border-l-4 bg-white p-2 shadow-sm', ci === 0 && i === 0 && 'animate-carry relative z-20']} style={`border-left-color:${prio}`}>
                                <div class="font-medium leading-snug text-ink">{title}</div>
                                <div class="mt-1 flex items-center justify-between text-stone-500"><span class="truncate">{who}</span><span class="grid size-5 place-items-center rounded-full bg-brand-100 text-[9px] font-semibold text-brand-700">{init}</span></div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- the chat: a question from a colleague and the answer that comes back, in the same window -->
    <div class="animate-float-slow absolute -bottom-2 -right-2 hidden w-60 rounded-xl bg-white p-3 text-[11px] shadow-2xl shadow-black/40 ring-1 ring-black/5 sm:block sm:-right-6" aria-hidden="true">
        <div class="flex items-center justify-between"><span class="text-sm font-semibold text-ink">Contact support</span><span class="rounded-full bg-emerald-50 px-1.5 py-0.5 font-medium text-emerald-700">Answered</span></div>
        <div class="mt-2 space-y-1.5">
            <div class="ml-auto w-4/5 rounded-xl rounded-br-sm bg-brand-600 px-2.5 py-1.5 text-white">Where do I change my caller ID?</div>
            <div class="w-4/5 rounded-xl rounded-bl-sm bg-stone-100 px-2.5 py-1.5 text-stone-700">Settings, Phone call. I set it for you.</div>
        </div>
    </div>
</div>
