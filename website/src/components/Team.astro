---
import Person from './Person.astro';
import { people } from '../data/site';
---
<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {people.map((p) => (
        <figure class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md">
            <div class:list={['relative overflow-hidden', p.photo ? 'h-72' : 'flex h-56 items-end justify-center ' + p.backdrop]}>
                {p.photo ? (
                    <>
                        <img src={p.photo} alt={p.photoAlt ?? p.role} width="800" height="1000" loading="lazy" class="size-full object-cover object-[50%_20%] transition duration-500 group-hover:scale-[1.03]" />
                        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink/55 to-transparent" aria-hidden="true"></div>
                        <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[11px] font-semibold text-stone-700 shadow-md ring-1 ring-black/5"><span class="text-emerald-500">&#10003;</span>{p.chip}</span>
                    </>
                ) : (
                    <>
                        <div class="absolute -right-6 -top-6 size-28 rounded-full bg-white/30" aria-hidden="true"></div>
                        <Person {...p.look} alt="" class="relative h-52 w-auto" />
                        <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[11px] font-semibold text-stone-700 shadow-md ring-1 ring-black/5"><span class="text-emerald-500">&#10003;</span>{p.chip}</span>
                    </>
                )}
            </div>
            <figcaption class="p-5">
                <p class="text-sm font-semibold text-stone-900">{p.role}</p>
                <p class="mt-1 text-sm leading-relaxed text-stone-600">{p.line}</p>
            </figcaption>
        </figure>
    ))}
</div>
<p class="mt-4 text-center text-xs text-stone-500">Stock portraits that show the people OrvynCRM is made for. They are not customers and these are not customer quotes.</p>
