---
// A friendly, drawn business person (head and shoulders). Used where a photo would go: pass `photo` to show a real photo instead.
interface Props {
    skin?: string; hair?: string; style?: 'long' | 'short' | 'bun' | 'curly'; outfit?: string; shirt?: string; glasses?: boolean; photo?: string; alt?: string; class?: string;
}
const { skin = '#f5d0b5', hair = '#3b2a20', style = 'short', outfit = '#4a6f9a', shirt = '#ffffff', glasses = false, photo, alt = '', class: cls = 'w-full' } = Astro.props;
---
{photo ? (
    <img src={photo} alt={alt} class:list={[cls, 'object-cover']} loading="lazy" />
) : (
    <svg viewBox="0 0 120 140" class={cls} role="img" aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} xmlns="http://www.w3.org/2000/svg">
        {style === 'long' && <path d="M26 66c0-26 14-42 34-42s34 16 34 42v34c0 6-6 8-12 8H38c-6 0-12-2-12-8z" fill={hair} />}
        {style === 'curly' && <g fill={hair}><circle cx="36" cy="46" r="15" /><circle cx="52" cy="34" r="16" /><circle cx="70" cy="34" r="16" /><circle cx="86" cy="46" r="15" /><circle cx="30" cy="64" r="12" /><circle cx="90" cy="64" r="12" /></g>}
        <path d="M8 140c0-30 22-40 52-40s52 10 52 40z" fill={outfit} />
        <path d="M44 102l16 20 16-20z" fill={shirt} />
        <rect x="51" y="82" width="18" height="22" rx="8" fill={skin} />
        <path d="M51 96c6 5 12 5 18 0v-6H51z" fill="#000" opacity=".08" />
        <ellipse cx="60" cy="62" rx="27" ry="29" fill={skin} />
        <ellipse cx="33.5" cy="64" rx="4" ry="6" fill={skin} /><ellipse cx="86.5" cy="64" rx="4" ry="6" fill={skin} />
        {style === 'short' && <path d="M32 58c-2-24 12-36 28-36s31 11 28 36c-6-12-14-18-28-18S38 46 32 58z" fill={hair} />}
        {style === 'bun' && <g fill={hair}><circle cx="60" cy="20" r="11" /><path d="M31 60c-3-24 11-37 29-37s32 13 29 37c-6-14-15-21-29-21S37 46 31 60z" /></g>}
        {style === 'long' && <path d="M32 62c-3-26 11-39 28-39s31 13 28 39c-8-6-14-17-20-22-6 6-20 17-36 22z" fill={hair} />}
        {style === 'curly' && <path d="M36 56c4-12 14-18 24-18s20 6 24 18c-8-6-16-8-24-8s-16 2-24 8z" fill={hair} />}
        <circle cx="49" cy="64" r="3" fill="#1d2433" /><circle cx="71" cy="64" r="3" fill="#1d2433" />
        <circle cx="50" cy="63" r="1" fill="#fff" /><circle cx="72" cy="63" r="1" fill="#fff" />
        <path d="M46 56q3-3 7-1M67 55q4-2 7 1" stroke={hair} stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M49 76q11 11 22 0" stroke="#7c2d12" stroke-width="2.6" fill="none" stroke-linecap="round" />
        <path d="M52 77q8 7 16 0z" fill="#fff" opacity=".9" />
        <circle cx="42" cy="73" r="4.5" fill="#f87171" opacity=".25" /><circle cx="78" cy="73" r="4.5" fill="#f87171" opacity=".25" />
        {glasses && <g fill="none" stroke="#1d2433" stroke-width="2.2"><circle cx="49" cy="64" r="9" /><circle cx="71" cy="64" r="9" /><path d="M58 64h4" /></g>}
    </svg>
)}
