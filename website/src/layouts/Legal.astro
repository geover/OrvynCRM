---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { legal, type Section } from '../data/legal';
import { site } from '../data/site';

interface Props { title: string; description: string; intro: string; sections: Section[]; other: { href: string; label: string } }
const { title, description, intro, sections, other } = Astro.props;
---
<Base title={title} description={description}>
    <PageHero eyebrow="Legal" highlight={title} crumb={title} meta={`Effective ${legal.effective} \u00b7 Last updated ${legal.updated}`} />

    <div class="container-page grid gap-10 py-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16 lg:py-16">
        <aside class="hidden lg:block">
            <nav aria-label="On this page" class="sticky top-24">
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">Contents</p>
                <ol class="mt-4 space-y-0.5 border-l border-stone-200 text-sm">
                    {sections.map((s, i) => <li><a href={`#${s.id}`} class="-ml-px flex gap-2 border-l-2 border-transparent py-1.5 pl-4 leading-snug text-stone-600 transition hover:border-brand-500 hover:text-brand-700"><span class="tabular-nums text-stone-500">{i + 1}.</span>{s.title}</a></li>)}
                </ol>
                <p class="mt-8 text-xs text-stone-500">Also read our <a href={other.href} class="font-medium text-brand-700 underline underline-offset-2">{other.label}</a>.</p>
            </nav>
        </aside>

        <article class="min-w-0 max-w-3xl">
            <p class="text-lg leading-relaxed text-stone-600">{intro}</p>
            {sections.map((s, i) => (
                <section id={s.id} class="scroll-mt-24 border-t border-stone-200 pt-8 mt-10">
                    <h2 class="text-xl font-semibold"><span class="mr-2 tabular-nums text-stone-500">{i + 1}.</span>{s.title}</h2>
                    <div class="mt-4 space-y-4 leading-relaxed text-stone-700">
                        {s.blocks.map((b) => 'p' in b
                            ? <p>{b.p}</p>
                            : <ul class="list-disc space-y-2 pl-5 marker:text-stone-500">{b.ul.map((item) => <li>{item}</li>)}</ul>)}
                        {s.contact && (
                            <address class="not-italic rounded-xl border border-stone-200 bg-white p-5 text-sm leading-relaxed shadow-sm">
                                <p class="font-semibold text-ink">{legal.entity}</p>
                                {legal.address && <p class="whitespace-pre-line text-stone-600">{legal.address}</p>}
                                <p class="mt-1"><a href={`mailto:${site.contactEmail}`} class="font-medium text-brand-700 underline underline-offset-2">{site.contactEmail}</a></p>
                            </address>
                        )}
                    </div>
                </section>
            ))}
            <p class="mt-12 border-t border-stone-200 pt-6 text-sm text-stone-500">See also: <a href={other.href} class="font-medium text-brand-700 underline underline-offset-2">{other.label}</a>.</p>
        </article>
    </div>
</Base>
