---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { docs } from '../data/docs';

interface Props { title: string; description: string; current?: string; toc?: { id: string; title: string }[] }
const { title, description, current, toc = [] } = Astro.props;
---
<Base title={title} description={description}>
    <div class:list={['container-page grid gap-8 py-8 lg:grid-cols-[14.5rem_minmax(0,1fr)] lg:gap-12 lg:py-12', toc.length > 0 && 'xl:grid-cols-[14.5rem_minmax(0,1fr)_12.5rem]']}>
        <div class="lg:sticky lg:top-24 lg:self-start">
            {/* small screens: a menu that opens and closes; large screens: the list is always there (below) */}
            <details class="group rounded-xl border border-stone-200 bg-white lg:hidden">
                <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink">
                    Documentation menu
                    <svg viewBox="0 0 20 20" class="size-4 transition group-open:rotate-180" aria-hidden="true" fill="currentColor"><path d="M5.5 7.5l4.5 4.5 4.5-4.5z" /></svg>
                </summary>
                <nav aria-label="Documentation" class="border-t border-stone-100 p-2">
                    <a href="/docs" class:list={['mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-semibold transition', !current ? 'bg-brand-50 text-brand-700' : 'text-ink hover:bg-stone-100']} aria-current={!current ? 'page' : undefined}>Overview</a>
                    <ul class="space-y-0.5">
                        {docs.map((d) => (
                            <li>
                                <a href={`/docs/${d.slug}`} aria-current={current === d.slug ? 'page' : undefined}
                                    class:list={['flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition', current === d.slug ? 'bg-brand-50 font-semibold text-brand-700' : 'text-stone-600 hover:bg-stone-100 hover:text-stone-900']}>
                                    <Icon name={d.icon} class="size-4 shrink-0" />{d.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </details>
            <nav aria-label="Documentation sections" class="hidden lg:block">
                <a href="/docs" class:list={['mb-1 flex items-center rounded-lg px-3 py-2 text-sm font-semibold transition', !current ? 'bg-brand-50 text-brand-700' : 'text-ink hover:bg-stone-100']} aria-current={!current ? 'page' : undefined}>Overview</a>
                <ul class="space-y-0.5">
                    {docs.map((d) => (
                        <li>
                            <a href={`/docs/${d.slug}`} aria-current={current === d.slug ? 'page' : undefined}
                                class:list={['flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition', current === d.slug ? 'bg-brand-50 font-semibold text-brand-700' : 'text-stone-600 hover:bg-stone-100 hover:text-stone-900']}>
                                <Icon name={d.icon} class="size-4 shrink-0" />{d.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>

        <article class="min-w-0"><slot /></article>

        {toc.length > 0 && (
            <nav aria-label="On this page" class="hidden xl:sticky xl:top-24 xl:block xl:self-start">
                <p class="text-xs font-semibold uppercase tracking-wider text-stone-500">On this page</p>
                <ul class="mt-3 space-y-2 border-l border-stone-200 text-sm">
                    {toc.map((t) => <li><a href={`#${t.id}`} class="-ml-px block border-l border-transparent pl-3 text-stone-600 transition hover:border-brand-500 hover:text-brand-700">{t.title}</a></li>)}
                </ul>
            </nav>
        )}
    </div>
</Base>
